# Wiggum (auto_ralph_loop) — environment template.
#
# Copy to `.env` and edit:  cp .env.example .env
# `.env` is gitignored (never committed); THIS file (.env.example) is committed
# as documentation of every knob.
#
# Precedence (lowest → highest):  built-in defaults  <  .env  <  CLI flags.
# orchestrator.sh and critic.py source `.env` if it exists in the repo root.
#
# ══════════════════════════════════════════════════════════════════════════════
#  PICK YOUR BACKENDS
#  Two independent roles, each pluggable:
#    • PROPOSER = a headless coding-agent CLI that does the work (the Ralph loop).
#    • CRITIC   = an LLM chat call that judges the evidence (the automated gate).
#  (README lore: proposer = Ralph, critic = Lisa, orchestrator = Maggie.)
#  Supported values: claude | codex | bebop
#    claude → Anthropic (Claude Code CLI for the proposer; Claude API for critic)
#    codex  → OpenAI     (Codex CLI for the proposer;      OpenAI API for critic)
#    bebop  → this repo's local selector → Compass/qwen via the cc-compass-shim
#  This file (main branch) defaults to `claude` so anyone can clone-and-run with
#  just an Anthropic key. Overlay branches only change these two lines:
#    branch `bebop`      → both = bebop   (our host: Compass proposer + critic)
#    branch `codex-demo` → both = codex   (OpenAI)
# ══════════════════════════════════════════════════════════════════════════════
WIGGUM_PROPOSER=claude
WIGGUM_CRITIC=claude

# ─────────────────────────────────────────────────────────────────────────────
#  ANTHROPIC / CLAUDE   (used when a role = claude)
# ─────────────────────────────────────────────────────────────────────────────
# Proposer uses the `claude` CLI (Claude Code) in headless mode; the critic uses
# the Messages API. Leave URL blank for the public Anthropic endpoint.
ANTHROPIC_API_KEY=
WIGGUM_CLAUDE_PROPOSER_MODEL=claude-opus-4-8
WIGGUM_CLAUDE_CRITIC_MODEL=claude-opus-4-8
# ANTHROPIC_BASE_URL=            # optional; e.g. a gateway. Blank = api.anthropic.com
# Critic-only overrides are useful when the proposer should keep its normal
# Claude CLI session while the critic uses an Anthropic-compatible local shim.
# WIGGUM_CLAUDE_CRITIC_BASE_URL=http://localhost:4000
# WIGGUM_CLAUDE_CRITIC_API_KEY=anything

# ─────────────────────────────────────────────────────────────────────────────
#  OPENAI / CODEX   (used when a role = codex)
# ─────────────────────────────────────────────────────────────────────────────
# Proposer uses the OpenAI `codex` CLI in headless/exec mode; the critic uses the
# Chat Completions API. NOTE: the codex path ships in this repo but is UNVERIFIED
# on our host (no Codex CLI here) — test it in your environment before relying on it.
OPENAI_API_KEY=
WIGGUM_CODEX_PROPOSER_MODEL=gpt-5-codex
WIGGUM_CODEX_CRITIC_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1

# ─────────────────────────────────────────────────────────────────────────────
#  BEBOP   (used when a role = bebop — our host only; not on main defaults)
# ─────────────────────────────────────────────────────────────────────────────
# Routes through the local `bebop` selector → cc-compass-shim → Compass/qwen.
# The proposer shells out to `bebop <backend> -p`; the critic can do the same
# (WIGGUM_CRITIC_VIA=bebop) or hit the LiteLLM API directly (WIGGUM_CRITIC_VIA=http).
WIGGUM_BEBOP_BACKEND=compass
WIGGUM_CRITIC_VIA=bebop
# Direct-API path (only when a bebop critic uses WIGGUM_CRITIC_VIA=http). Don't
# hardcode a secret in a committed file — in the real .env read it from source:
#   WIGGUM_COMPASS_KEY=$(grep -oP 'LITELLM_MASTER_KEY=\K.*' /root/litellm/.env)
WIGGUM_COMPASS_URL=http://localhost:4000/v1/chat/completions
WIGGUM_COMPASS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  LOOP BEHAVIOR
# ─────────────────────────────────────────────────────────────────────────────
# Spec grammar. Empty = auto-detect: a GitHub Spec Kit tasks.md (by filename or by
# "## Phase N:" + "- [ ]" task lines) → speckit-tasks; everything else → native
# ("## Phase <N>" + "### Acceptance criteria"). Force one with native|speckit-tasks
# (the --spec-format CLI flag overrides this).
WIGGUM_SPEC_FORMAT=
# Feature namespace for durable state (.wiggum/features/<slug>/), for a repo with
# more than one Spec Kit feature. Empty = derive from the spec's .specify feature
# dir (its basename), else "default". Also disambiguates specs/*/tasks.md when more
# than one exists. The --feature CLI flag overrides this.
WIGGUM_FEATURE=
# Total char budget for the Spec Kit context set injected into the proposer + critic
# (spec/plan/contracts/… as read-only background). Allocated in descending gating
# order with per-doc floors; truncation is line-clean and code-fence-safe. Only
# applies to speckit-tasks specs inside a .specify project.
WIGGUM_CONTEXT_BUDGET=24000
# Max times the critic may REJECT one phase before the run halts for a human.
WIGGUM_MAX_REJECTS=3
# Max proposer (headless) passes per phase before giving up on producing evidence.
WIGGUM_MAX_ITER=30
# Hard timeout (seconds) on a single proposer pass / a single critic HTTP call.
WIGGUM_PROPOSER_TIMEOUT=1800
WIGGUM_CRITIC_TIMEOUT=300
# Whole-run wall-clock budget in minutes; 0 = unlimited. Checked between steps,
# halts cleanly at the next phase boundary (exit 4).
WIGGUM_MAX_WALL_MIN=0
# Grounded critic: before the LLM call, verify file paths cited in the evidence
# (exists/size/mtime + bounded excerpt) and append that snapshot to the critic
# prompt. Read-only; keeps a self-reported evidence file honest.
WIGGUM_CRITIC_GROUNDING=true
# Per-phase git checkpoint: after each .wiggum/gates/GATE<N>-APPROVED the orchestrator commits
# the workdir ("wiggum: phase <N> approved — <title>") so phases are diffable
# and revertable. `auto` = commit only if the workdir is already a git repo and
# has changes (never inits, never pushes). Set `off` to disable.
WIGGUM_GIT_COMMITS=auto
# Inline live view: stream a clean, colored scrolling timeline in the launching
# terminal (like a coding agent working), routing raw proposer/critic output to
# run.log only. `auto` = on when stdout is a TTY, off when piped/backgrounded. Set
# `true` to force on, `false` for the legacy raw tee'd output. (--live / --no-live
# flags override this.) Color is auto-on at a TTY and auto-stripped when piped;
# the --no-color flag on present.py / `wiggum events|watch` forces it off.
WIGGUM_LIVE=auto

# ─────────────────────────────────────────────────────────────────────────────
#  OBSERVABILITY — live agent-stream capture (no containers; always local)
# ─────────────────────────────────────────────────────────────────────────────
# Parse the proposer's headless stream-json into structured events in
# .wiggum/events.jsonl (agent_init / agent_tool / agent_text / agent_result, plus
# evidence_writing when a Write/Edit/Bash touches a GATE<N>-EVIDENCE.md). This is
# what makes the timeline show every tool call live and the watch card show run
# totals — independent of telemetry. `false` = legacy raw path (no per-tool
# events; a --telemetry run still ships to Loki via the old shipper). Degrades to
# false automatically if lib/agent_stream.py or python3 is missing.
WIGGUM_AGENT_STREAM=true
# Live/timeline verbosity for the agent stream: milestones | tools | full.
#   milestones → lifecycle + evidence only (quietest)
#   tools      → also narrate each agent tool call (default)
#   full       → also narrate assistant text blocks (loudest)
WIGGUM_LIVE_DETAIL=tools

# ─────────────────────────────────────────────────────────────────────────────
#  TELEMETRY — OPTIONAL. Off by default; only active with the `--telemetry` flag.
#  Self-contained Loki+Grafana. This is a NEW, INDEPENDENT deployment: pick ports
#  that are FREE on your machine. Our host's observability stack already uses
#  :3000 (Grafana) and :3100 (Loki), so the defaults below deliberately avoid
#  them (confirmed free here with `ss -ltn`). Change if you hit a collision.
# ─────────────────────────────────────────────────────────────────────────────
WIGGUM_TELEMETRY_ENABLED=false
WIGGUM_LOKI_PORT=3110
WIGGUM_GRAFANA_PORT=3010
# Where ralph_loki_ship.py pushes events (must match WIGGUM_LOKI_PORT above).
WIGGUM_LOKI_URL=http://localhost:3110

# ─────────────────────────────────────────────────────────────────────────────
#  OTEL — OPTIONAL, independent OpenTelemetry sink. Off by default; active with the
#  `--otel` flag. Ships the SAME event stream as OTLP/HTTP+JSON (stdlib only, no pip)
#  to the bundled OTEL Collector, which forwards logs to the same Loki (so the
#  existing "Ralph Loops" dashboard keeps working) and exposes metrics
#  (ralph_cost_usd_total, ralph_tokens_total, ralph_iter_duration_ms, …) to a bundled
#  Prometheus. `--telemetry` and `--otel` are independent: enable either or BOTH
#  (dual-ship). Ports below avoid the common OTLP :4318/:4317 in case they're taken.
# ─────────────────────────────────────────────────────────────────────────────
WIGGUM_OTEL_ENABLED=false
WIGGUM_OTEL_PORT=4318            # OTLP/HTTP the shipper posts to (host:container 4318)
WIGGUM_OTEL_GRPC_PORT=4317       # OTLP/gRPC (unused by the shipper; exposed for convenience)
WIGGUM_PROMETHEUS_PORT=9091      # bundled Prometheus UI (avoids the common :9090)
# Where ralph_otel_ship.py posts OTLP (must match WIGGUM_OTEL_PORT above).
WIGGUM_OTEL_URL=http://localhost:4318
