# ─────────────────────────────────────────────────────────────────────────────
# DRAFT — systemd unit for the Phase 8 remote @lisa/server (reusable-platform-sdk)
# ─────────────────────────────────────────────────────────────────────────────
# Replaces the hand-started `nohup lisa serve --port 8790` stopgap (2026-08-01)
# with a durable, reboot-surviving authenticated remote daemon that Phase 8's
# live demonstration (T059 remote run, T061 gateway path) connects to.
#
# Install:
#   1. Generate the token ONCE and store it out of git, readable at source time:
#        install -m 600 /dev/stdin /etc/lisa/remote-daemon.token <<<"rmt_$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
#   2. Create the env file the unit reads (keeps the secret out of the unit + .env):
#        /etc/lisa/remote-daemon.env  (mode 600):
#            LISA_SERVER_HOST=127.0.0.1
#            LISA_SERVER_TOKENS=<paste the token>=phase8-critic
#            IS_SANDBOX=1
#   3. cp this file to /etc/systemd/system/lisa-remote-daemon.service
#   4. systemctl daemon-reload && systemctl enable --now lisa-remote-daemon
#   5. Point wiggum .env at it (dynamic read, never hardcode — matches the
#      WIGGUM_COMPASS_KEY pattern already in .env):
#        LISA_URL=ws://127.0.0.1:8790/rpc
#        LISA_TOKEN=$(cat /etc/lisa/remote-daemon.token)   # sourced as shell → substitutes
#
# NOTE: the current stopgap hardcodes LISA_TOKEN literally in /root/wiggum/.env,
# which violates that file's own "never hardcode a secret" rule. Step 5 fixes it.
# ─────────────────────────────────────────────────────────────────────────────

[Unit]
Description=Lisa remote @lisa/server (Phase 8 live-demo target, port 8790)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust WorkingDirectory to the lisa monorepo root that owns packages/cli/bin/lisa.mjs.
WorkingDirectory=/root/lisa
# A dedicated, persistent workspace (NOT /tmp, which is cleaned) for the daemon's
# .lisa/ state + socket. Pre-seed roadmap/spec.md so run requests have a spec.
Environment=LISA_REMOTE_WORKDIR=/var/lib/lisa/remote-daemon
EnvironmentFile=/etc/lisa/remote-daemon.env
ExecStartPre=/usr/bin/install -d -m 700 /var/lib/lisa/remote-daemon/roadmap
ExecStartPre=/bin/sh -c 'test -f /var/lib/lisa/remote-daemon/roadmap/spec.md || printf "# Remote daemon spec\n\n- [ ] T001 smoke\n" > /var/lib/lisa/remote-daemon/roadmap/spec.md'
ExecStart=/usr/bin/node packages/cli/bin/lisa.mjs serve -w /var/lib/lisa/remote-daemon --port 8790
Restart=on-failure
RestartSec=3
# Hardening: the daemon only needs its own state dir + the read-only monorepo.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lisa/remote-daemon
ProtectHome=false

[Install]
WantedBy=multi-user.target
