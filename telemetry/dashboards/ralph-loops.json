    "wiggum"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About this dashboard",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Autonomous Wiggum **Ralph loops**, provider-neutral. Each iteration is a fresh headless proposer/critic invocation; this dashboard tracks cost, tokens, tool use, iteration duration and gate outcomes per run regardless of backend (Claude, Prime standard, Prime fleet, …). Queries match both the Claude stream vocabulary (`api_request`/`tool_use`) and the normalized Prime vocabulary (`agent_result`/`agent_tool`) so no backend has to masquerade as another. Use the **task**, **backend** and **role** variables to focus, and the **run**/**invocation** variables to query by Prime run/invocation identifier. Data is the persistent Loki event stream (`job=\"ralph\"`) over the time range."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"ralph\", event=\"run_start\", task=~\"$task\", backend=~\"$backend\", role=~\"$role\"} | logfmt | run_id=~\"$run\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
